{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SI TTS Sample",
  "type": "object",
  "required": [
    "sample_id",
    "lang",
    "domain",
    "length_tier",
    "difficulty_tags",
    "style",
    "text",
    "target_duration_sec",
    "voice",
    "group_id"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "pattern": "^(ja|ko|ru|th)-D(0[1-9]|10)-(S|M|L|XL)-\\d{3}$"
    },
    "lang": {
      "type": "string",
      "enum": ["ja", "ko", "ru", "th"]
    },
    "domain": {
      "type": "string",
      "enum": [
        "diplomacy",
        "business",
        "technology",
        "health",
        "legal",
        "education",
        "energy",
        "press",
        "culture",
        "emergency"
      ]
    },
    "length_tier": {
      "type": "string",
      "enum": ["S", "M", "L", "XL"]
    },
    "difficulty_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "numbers",
          "proper_nouns",
          "terminology",
          "logic",
          "enumeration",
          "plain"
        ]
      }
    },
    "style": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_sec": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "voice": {
      "type": "string"
    },
    "group_id": {
      "type": ["string", "null"]
    }
  }
}
